{
  "info": {
    "name": "Spotter Fuel Route API",
    "description": "Demo requests for the fuel route API. Start the server (python manage.py runserver) and send in order. Each request has tests (see the Test Results tab) that re-check the fuel arithmetic. Change the baseUrl collection variable if the server is not on http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('stations loaded', () => pm.expect(pm.response.json().stations.routable).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health/"
      }
    },
    {
      "name": "Stations - cheapest in Texas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('sorted by price', () => { const p = pm.response.json().results.map(s => s.retail_price);",
              "  pm.expect(p).to.eql([...p].sort((a, b) => a - b)); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/stations/?state=TX&limit=10"
      }
    },
    {
      "name": "Route - New York to Los Angeles (multiple stops)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('each stop: cost = gallons x price', () => d.fuel_stops.forEach(s =>",
              "  pm.expect(Math.abs(s.gallons_purchased * s.price_per_gallon - s.cost)).to.be.at.most(0.0051)));",
              "pm.test('total = sum of stop costs', () => {",
              "  const sum = d.fuel_stops.reduce((a, s) => a + s.cost, 0);",
              "  pm.expect(Math.abs(sum - d.summary.total_fuel_cost)).to.be.below(0.006); });",
              "pm.test('gallons used = miles / 10', () =>",
              "  pm.expect(Math.abs(d.summary.total_gallons_used - d.route.distance_miles / 10)).to.be.below(0.01));",
              "pm.test('tank never above 50 gal', () => d.fuel_stops.forEach(s => pm.expect(s.fuel_on_departure_gallons).to.be.at.most(50)));",
              "pm.test('no leg longer than 500 miles', () => {",
              "  const m = d.fuel_stops.map(s => s.mile_marker); const pts = [0, ...m, d.route.distance_miles];",
              "  for (let i = 1; i < pts.length; i++) pm.expect(pts[i] - pts[i-1]).to.be.at.most(500.1); });",
              "pm.test('at most 3 external API calls', () => pm.expect(d.meta.external_api_calls.total).to.be.at.most(3));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/route/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
