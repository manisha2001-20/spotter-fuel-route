# Copy to .env and adjust. Every value is optional for local development.
# No API keys are needed: OSRM and Nominatim are free public services.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true only when the site is served over HTTPS (enables HSTS, secure cookies, SSL redirect)
DJANGO_SECURE_SSL=false

# Vehicle assumptions from the assessment
VEHICLE_RANGE_MILES=500
MILES_PER_GALLON=10

# Planner tuning
CORRIDOR_MILES=10
START_WINDOW_MILES=25
DOMINANCE_WINDOW_MILES=15

# External services (free, no key). Point these at self-hosted instances for production use.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=spotter-fuel-route/1.0
GEOCODE_TIMEOUT_SECONDS=8
ROUTE_TIMEOUT_SECONDS=20
